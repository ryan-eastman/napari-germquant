# ---- microscopy data and results never go in the repository ----
*.nd2
*.tif
*.tiff
*.ome.tif
*.ome.tiff
*.czi
*.lif
*.ims
*.zarr/
results/
results_*/
*_results/

# ---- python ----
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.ruff_cache/
.pytest_cache/

# ---- os / editor ----
.DS_Store
.vscode/
.idea/

# The test pack is a copy of the engine's tests/fixtures/packs/test_pack and is tracked in full: its example
# is an .ome.tif, ignored everywhere above. Only a folder-wide negation works (git never re-includes a file
# whose parent folder is excluded), and these lines must stay LAST. The re-ignores keep caches and .DS_Store
# out of it, as in the engine (docs/DESIGN_system_packs.md 3.7).
!/tests/fixtures/packs/**
/tests/fixtures/packs/**/__pycache__/
/tests/fixtures/packs/**/*.py[cod]
/tests/fixtures/packs/**/.DS_Store
